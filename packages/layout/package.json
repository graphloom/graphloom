{
  "name": "@graphloom/layout",
  "version": "0.0.2",
  "description": "GraphLoom layout package",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphloom/graphloom.git",
    "directory": "packages/layout"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/worker.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@graphloom/core": "workspace:*",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2"
  },
  "devDependencies": {
    "@graphloom/history": "workspace:*"
  }
}
